---
import Layout from "../layouts/Layout.astro";

import SectionContainer from "../components/SectionContainer.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Briefcase from "../components/Briefcase.astro";
import CodeIcon from "../icons/Code.astro";
import Profile from "../components/Profile.astro";
import AboutMe from "../components/AboutMe.astro";
import AboutIcon from "../icons/About.astro";
import FocusAreas from "../components/FocusAreas.astro";
import FeaturedCaseStudy from "../components/FeaturedCaseStudy.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { SECTION_ID, SITE_CONTENT } from "../data/portfolio";
---

<Layout title={SITE_CONTENT.metaTitle} description={SITE_CONTENT.metaDescription}>
  <main id="main-content" class="pb-10 pt-28 md:pt-32">
    <SectionContainer id={SECTION_ID.HOME} class="py-8 md:py-14">
      <Profile />
    </SectionContainer>

    <div class="space-y-14 md:space-y-20">
      <SectionContainer id={SECTION_ID.FOCUS}>
        <p class="section-kicker">Current Focus</p>
        <h2 class="section-title">Engineering Domains I Build In</h2>
        <p class="section-description">
          My work combines data pipeline reliability with agentic workflow experimentation and production delivery practices.
        </p>
        <FocusAreas />
      </SectionContainer>

      <SectionContainer id={SECTION_ID.CASE_STUDY}>
        <p class="section-kicker">Recent Development</p>
        <h2 class="section-title">Featured Agentic Project</h2>
        <p class="section-description">
          This is the latest product I launched, focused on clarity, trust, and practical user value.
        </p>
        <FeaturedCaseStudy />
      </SectionContainer>

      <SectionContainer id={SECTION_ID.EXPERIENCE}>
        <h2 class="section-title section-title-icon">
          <Briefcase class="size-5 text-cyan-200" aria-hidden="true" />
          Experience
        </h2>
        <p class="section-description">
          Roles where I improved data reliability, orchestration quality, and delivery speed.
        </p>
        <Experience />
      </SectionContainer>

      <SectionContainer id={SECTION_ID.PROJECTS}>
        <h2 class="section-title section-title-icon">
          <CodeIcon class="size-5 text-cyan-200" aria-hidden="true" />
          Selected Projects
        </h2>
        <p class="section-description">
          Additional technical work across web engineering and applied optimization.
        </p>
        <Projects />
      </SectionContainer>

      <SectionContainer id={SECTION_ID.ABOUT}>
        <h2 class="section-title section-title-icon">
          <AboutIcon class="size-5 text-cyan-200" aria-hidden="true" />
          About
        </h2>
        <AboutMe />
      </SectionContainer>

      <SectionContainer id={SECTION_ID.CONTACT}>
        <ContactPanel />
      </SectionContainer>
    </div>
  </main>
</Layout>
