---
import { SITE_CONTENT } from "../data/portfolio";
interface Props { workPage?: boolean }
const { workPage = false } = Astro.props;
const home = Astro.url.pathname === "/";
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={home ? "#home" : "/"} aria-label="Jesús Muñoz González — home">JM<span aria-hidden="true">.</span></a>
    <nav aria-label="Primary">
      {SITE_CONTENT.navItems.map(({ label, section }) => (
        <a href={home ? `#${section}` : `/#${section}`} data-nav-section={section} aria-current={workPage && section === "work" ? "location" : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  import "../scripts/navigation";
</script>
