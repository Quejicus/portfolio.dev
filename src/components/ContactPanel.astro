---
import { SITE_CONTENT as site } from "../data/portfolio";
---
<div class="contact-panel">
  <div><p class="eyebrow">Contact</p>
    <h2>Let’s build something<br />that works at scale<span class="accent">.</span></h2>
    <p class="muted">Open to data engineering opportunities and thoughtful technical conversations. Based in Spain, available for remote work.</p>
  </div>
  <div class="contact-actions">
    <a class="email-link" href={`mailto:${site.email}`} data-event="contact_email">{site.email}<span aria-hidden="true">↗</span></a>
    <div class="actions">
      <button class="button secondary" id="copy-email" data-email={site.email} hidden>Copy email <span aria-hidden="true">⧉</span></button>
      <a class="button secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer" data-event="contact_link">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    </div>
    <p class="copy-status small" id="copy-status" role="status" aria-live="polite"></p>
  </div>
</div>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-email");
  const status = document.querySelector<HTMLElement>("#copy-status");
  if (copyButton && status) {
    copyButton.hidden = false;
    copyButton.addEventListener("click", async () => {
      const email = copyButton.dataset.email;
      if (!email) return;
      try {
        if (!navigator.clipboard) throw new Error("Clipboard unavailable");
        await navigator.clipboard.writeText(email);
        status.textContent = "Email copied. Ready to paste.";
      } catch {
        status.textContent = "Copy unavailable. Select the email address above, or use the email link.";
      }
    });
  }
</script>
