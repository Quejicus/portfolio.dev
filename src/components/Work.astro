---
import { CASE_STUDIES } from "../data/work";
---
<div class="work-grid">
  {CASE_STUDIES.map((entry, index) => (
    <article class:list={["work-card", { "work-card-product": entry.image }]}>
      <a class="work-visual" href={`/work/${entry.slug}/`} tabindex="-1" aria-hidden="true">
        {entry.image ? <img src={entry.image} alt="" width={entry.imageWidth} height={entry.imageHeight} loading="lazy" decoding="async" /> :
          <div class="work-stat"><span>{entry.metric}</span><p>{entry.metricLabel}</p><div class="mini-flow"><span>{index === 0 ? "PENTAHO" : "PYSPARK"}</span><span>→</span><span>{index === 0 ? "AIRFLOW" : "HBASE"}</span></div></div>}
      </a>
      <div class="work-copy"><p class="eyebrow">{entry.category}</p>
        <h3><a href={`/work/${entry.slug}/`} data-event="project_open">{entry.shortTitle}<span aria-hidden="true">↗</span></a></h3>
        <p class="muted">{entry.summary}</p>
        <ul class="tags" aria-label="Technologies">{entry.stack.map((tech) => <li>{tech}</li>)}</ul>
        <a class="text-link" href={`/work/${entry.slug}/`} data-event="project_open">Read {index < 2 ? "case study" : "project overview"}<span class="sr-only">: {entry.shortTitle}</span> <span aria-hidden="true">→</span></a>
      </div>
    </article>
  ))}
</div>
