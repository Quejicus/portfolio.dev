---
import { getContent, getLocale, localizePath } from "../i18n";
const locale = getLocale(Astro.url.pathname);
const { caseStudies, ui } = getContent(locale);
---
<div class="work-grid">
  {caseStudies.map((entry) => (
    <article class:list={["work-card", { "work-card-product": entry.image }]}>
      <a class="work-visual" href={localizePath(`/work/${entry.slug}/`, locale)} tabindex="-1" aria-hidden="true">
        {entry.image ? <img src={entry.image} alt="" width={entry.imageWidth} height={entry.imageHeight} loading="lazy" decoding="async" /> :
          <div class="work-stat"><span>{entry.metric}</span><p>{entry.metricLabel}</p>{entry.previewFlow && <div class="mini-flow"><span>{entry.previewFlow[0]}</span><span>→</span><span>{entry.previewFlow[1]}</span></div>}</div>}
      </a>
      <div class="work-copy"><p class="eyebrow">{entry.category}</p>
        <h3><a href={localizePath(`/work/${entry.slug}/`, locale)} data-event="project_open">{entry.shortTitle}<span aria-hidden="true">↗</span></a></h3>
        <p class="muted">{entry.summary}</p>
        <ul class="tags" aria-label={ui.technologies}>{entry.stack.map((tech) => <li>{tech}</li>)}</ul>
        <a class="text-link" href={localizePath(`/work/${entry.slug}/`, locale)} data-event="project_open">{entry.linkLabel} <span aria-hidden="true">→</span></a>
      </div>
    </article>
  ))}
</div>
