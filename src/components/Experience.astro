---
import { getContent, getLocale } from "../i18n";
const { site, ui } = getContent(getLocale(Astro.url.pathname));
---
<ol class="experience-list">
  {site.experience.map((entry) => (
    <li class="experience-row">
      <div class="experience-meta">
        <p class="date-range"><time datetime={entry.start}>{entry.startLabel}</time> — {entry.end ? <time datetime={entry.end}>{entry.endLabel}</time> : entry.endLabel}</p>
        <p class="company">{entry.company}</p>
      </div>
      <div>
        <h3>{entry.role}</h3>
        <p class="muted">{entry.summary}</p>
        <ul class="bullet-list">{entry.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
        {entry.additional.length > 0 && <details><summary>{ui.experience.more}</summary><ul class="bullet-list">{entry.additional.map((highlight) => <li>{highlight}</li>)}</ul></details>}
      </div>
    </li>
  ))}
</ol>
