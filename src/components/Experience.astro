---
import { SITE_CONTENT } from "../data/portfolio";

const experienceEntries = SITE_CONTENT.experience;
---

<ol class="relative space-y-7 before:absolute before:bottom-0 before:left-[7.1rem] before:top-2 before:w-px before:bg-white/10 md:before:left-[10.2rem]">
  {
    experienceEntries.map((entry) => (
      <li class="relative grid gap-4 md:grid-cols-[9.5rem_1fr] md:gap-8">
        <div class="relative">
          <time class="text-xs font-semibold uppercase tracking-[0.15em] text-cyan-200">{entry.dateRange}</time>
        </div>

        <article class="relative rounded-2xl border border-white/10 bg-[#0f1928]/80 p-5">
          <span
            class="absolute -left-6 top-6 hidden size-3 rounded-full border border-cyan-200/80 bg-[#0f1928] md:block"
            aria-hidden="true"
          ></span>
          <h3 class="text-lg font-semibold text-slate-100">{entry.role}</h3>
          <p class="text-sm font-medium text-cyan-200">{entry.company}</p>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">{entry.summary}</p>

          <ul class="mt-4 space-y-2 text-sm text-slate-200">
            {entry.highlights.map((highlight) => (
              <li class="flex gap-2">
                <span class="mt-[0.42rem] size-1.5 rounded-full bg-cyan-300/85" aria-hidden="true"></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </article>
      </li>
    ))
  }
</ol>
