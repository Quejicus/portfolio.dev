---
import { SITE_CONTENT } from "../data/portfolio";

const about = SITE_CONTENT.about;
---

<article class="grid gap-8 rounded-3xl border border-white/10 bg-[#101b2a]/80 p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
  <div class="space-y-4 text-sm leading-relaxed text-slate-300 md:text-base">
    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <img
    width="220"
    height="220"
    src="/img/profile_pic.webp"
    alt="Portrait of Jesús Muñoz González"
    class="mx-auto h-44 w-44 rounded-3xl object-cover ring-1 ring-white/20 md:h-52 md:w-52"
    loading="lazy"
  />
</article>
