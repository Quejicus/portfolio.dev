---
import { getContent, getLocale } from "../i18n";
const { site, ui } = getContent(getLocale(Astro.url.pathname));
const about = ui.about;
---
<div class="about-grid">
  <div class="about-copy">
    <p class="lead">{about.lead}</p>
    <p>{about.introduction}</p>
    <p>{about.background}</p>
    <p class="muted">{about.personal}</p>
    <dl class="facts">
      <div><dt>{about.languages}</dt><dd>{about.spanish}<br />{about.english}</dd></div>
      <div><dt>{about.education}</dt><dd>{about.degree}<br /><time datetime="2011">2011</time> – <time datetime="2016">2016</time><br />Data Science Bootcamp · NEOLAND<br /><time datetime="2021-09">{about.september}</time> – <time datetime="2021-12">{about.december2021}</time></dd></div>
    </dl>
  </div>
  <div class="credentials">
    <p class="eyebrow">{about.learning}</p><h3>{about.credentials}</h3>
    <ul>{site.credentials.map((credential) => (
      <li><h4>{credential.title}</h4><p>{credential.issuer} <span aria-hidden="true">/</span> <time datetime={credential.date}>{credential.label}</time></p></li>
    ))}</ul>
    <p class="small muted">{about.credentialDates}</p>
  </div>
</div>
