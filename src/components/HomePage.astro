---
import Layout from "../layouts/Layout.astro";
import Profile from "./Profile.astro";
import Work from "./Work.astro";
import Experience from "./Experience.astro";
import FocusAreas from "./FocusAreas.astro";
import AboutMe from "./AboutMe.astro";
import ContactPanel from "./ContactPanel.astro";
import { getContent, getLocale } from "../i18n";
const { site, ui } = getContent(getLocale(Astro.url.pathname));
---
<Layout title={site.metaTitle} description={site.metaDescription}>
  <main id="main-content" tabindex="-1">
    <section id="home" class="container hero"><Profile /></section>
    <section id="work" data-section="work" class="container section">
      <span id="projects" class="anchor-alias" aria-hidden="true"></span><span id="case-study" class="anchor-alias" aria-hidden="true"></span>
      <div class="section-heading"><div><p class="eyebrow">{ui.work.eyebrow}</p><h2>{ui.work.title}<br />{ui.work.titleEnd}</h2></div><p class="muted">{ui.work.description}</p></div>
      <Work />
    </section>
    <section id="services" data-section="services" class="container section">
      <div class="capability-section" id="focus"><h2 class="eyebrow">{ui.services}</h2><FocusAreas /></div>
    </section>
    <section id="experience" data-section="experience" class="container section">
      <div class="section-heading"><div><p class="eyebrow">{ui.experience.eyebrow}</p><h2>{ui.experience.title}</h2></div><a class="text-link" href={site.resume.href} download={site.resume.fileName} data-event="cv_download">{ui.experience.cv} <span aria-hidden="true">↓</span></a></div>
      <Experience />
    </section>
    <section id="about" data-section="about" class="container section">
      <div class="section-heading"><div><p class="eyebrow">{ui.about.eyebrow}</p><h2>{ui.about.title}<br />{ui.about.titleEnd}</h2></div></div>
      <AboutMe />
    </section>
    <section id="contact" data-section="contact" class="container section"><ContactPanel /></section>
  </main>
</Layout>
