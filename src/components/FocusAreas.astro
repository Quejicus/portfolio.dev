---
import { SITE_CONTENT } from "../data/portfolio";

const focusAreas = SITE_CONTENT.focusAreas;
---

<div class="grid gap-4 md:grid-cols-3">
  {
    focusAreas.map((area) => (
      <article class="group rounded-2xl border border-white/10 bg-[#101a28]/80 p-5 transition hover:-translate-y-1 hover:border-cyan-300/40 hover:shadow-[0_12px_34px_rgba(8,145,178,0.18)]">
        <h3 class="text-lg font-semibold text-slate-100">{area.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-300">{area.description}</p>
        <ul class="mt-4 space-y-2 text-sm text-slate-200">
          {area.bullets.map((bullet) => (
            <li class="flex items-start gap-2">
              <span class="mt-[0.33rem] size-1.5 rounded-full bg-cyan-300/75" aria-hidden="true"></span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
