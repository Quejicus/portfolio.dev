---
import { getContent, getLocale, localizePath } from "../i18n";
const locale = getLocale(Astro.url.pathname);
const { site, ui } = getContent(locale);
const hero = ui.hero;
---
<div class="hero-intro">
  <div>
    <p class="eyebrow availability"><span aria-hidden="true"></span> {hero.availability}</p>
    <h1 translate="no">Jesús Muñoz<br class="desktop-break" /> González<span class="accent">.</span></h1>
    <p class="hero-role">{hero.role}</p>
    <p class="hero-summary">{hero.summary}</p>
    <div class="actions hero-actions">
      <a class="button primary" href="#contact">{hero.contact} <span aria-hidden="true">↓</span></a>
      <a class="button secondary" href="#work">{hero.projects} <span aria-hidden="true">↗</span></a>
    </div>
    <p class="hero-context">{hero.tenure} <span aria-hidden="true">·</span> {hero.location}</p>
  </div>
  <aside class="hero-aside" aria-label={hero.glance}>
    <div class="identity">
      <img src="/img/profile_pic.webp" alt="" width="80" height="80" fetchpriority="high" />
      <div><p class="eyebrow">{hero.currently}</p><p>{hero.currentRole}<br /><strong>{hero.currentCompany}</strong></p></div>
    </div>
    <div class="pipeline-art" aria-hidden="true">
      <div class="pipeline-label">{hero.pipeline}</div>
      <div class="pipeline-stage"><span>01</span> {hero.stages[0]} <i></i><small>JavaScript / Astro / {locale === "es" ? "IA" : "AI"}</small></div>
      <div class="pipeline-connector"></div>
      <div class="pipeline-stage"><span>02</span> {hero.stages[1]} <i></i><small>Python / APIs / Airflow</small></div>
      <div class="pipeline-connector"></div>
      <div class="pipeline-stage"><span>03</span> {hero.stages[2]} <i></i><small>SQL / dbt / Dashboards</small></div>
      <div class="pipeline-caption">{hero.pipelineCaption}</div>
    </div>
    <div class="social-row">
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" data-event="contact_link">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">{ui.newTab}</span></a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">{ui.newTab}</span></a>
      <a href={`mailto:${site.email}`} data-event="contact_email">{ui.email} <span aria-hidden="true">↗</span></a>
    </div>
  </aside>
</div>
<dl class="impact-strip" aria-label={hero.impact}>
  {site.metrics.map((metric) => (
    <div><dt>{metric.label}</dt><dd><a href={localizePath(metric.href, locale)} aria-label={`${metric.value}: ${metric.label}`} data-event="project_open">{metric.value}<span aria-hidden="true">↗</span></a></dd></div>
  ))}
</dl>
