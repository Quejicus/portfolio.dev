---
import { SITE_CONTENT as site } from "../data/portfolio";
---
<div class="hero-intro">
  <div>
    <p class="eyebrow availability"><span aria-hidden="true"></span> Open to data engineering opportunities</p>
    <h1>Jesús Muñoz<br class="desktop-break" /> González<span class="accent">.</span></h1>
    <p class="hero-role">Analytics Engineer <span aria-hidden="true">/</span> dbt & SQL</p>
    <p class="hero-summary">I build trusted analytics layers with dbt and SQL, backed by reliable cloud data platforms and production ETL.</p>
    <div class="actions hero-actions">
      <a class="button primary" href={site.resume.href} download={site.resume.fileName} data-event="cv_download">Download CV <span class="button-note">(PDF)</span><span aria-hidden="true">↓</span></a>
      <a class="button secondary" href="#work">Explore my work <span aria-hidden="true">↗</span></a>
    </div>
    <p class="hero-context">4+ years since <time datetime="2022-06">June 2022</time> <span aria-hidden="true">·</span> Spain / remote</p>
  </div>
  <aside class="hero-aside" aria-label="At a glance">
    <div class="identity">
      <img src="/img/profile_pic.webp" alt="" width="80" height="80" fetchpriority="high" />
      <div><p class="eyebrow">Currently</p><p>Data Engineer<br /><strong>NTT DATA Europe & LATAM</strong></p></div>
    </div>
    <div class="pipeline-art" aria-hidden="true">
      <div class="pipeline-label">FROM RAW DATA TO RELIABLE SYSTEMS</div>
      <div class="pipeline-stage"><span>01</span> Ingest <i></i><small>Python / SQL</small></div>
      <div class="pipeline-connector"></div>
      <div class="pipeline-stage"><span>02</span> Model <i></i><small>dbt / SQL</small></div>
      <div class="pipeline-connector"></div>
      <div class="pipeline-stage"><span>03</span> Orchestrate <i></i><small>Airflow</small></div>
      <div class="pipeline-caption">TEST · OBSERVE · ITERATE</div>
    </div>
    <div class="social-row">
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" data-event="contact_link">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      <a href={`mailto:${site.email}`} data-event="contact_email">Email <span aria-hidden="true">↗</span></a>
    </div>
  </aside>
</div>
<dl class="impact-strip" aria-label="Selected professional impact">
  {site.metrics.map((metric) => (
    <div><dt>{metric.label}</dt><dd><a href={metric.href} data-event="project_open">{metric.value}<span aria-hidden="true">↗</span></a></dd></div>
  ))}
</dl>
