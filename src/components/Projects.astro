---
import GitHubIcon from "../icons/GitHub.astro";
import LinkIcon from "../icons/Link.astro";
import {
  PROJECT_LINK_KIND,
  PROJECT_VISUAL_STYLE,
  SITE_CONTENT,
} from "../data/portfolio";

const projects = SITE_CONTENT.projects;

const imageByStyleClass = {
  [PROJECT_VISUAL_STYLE.DEFAULT]:
    "h-44 w-full object-cover object-top transition duration-300 group-hover:scale-[1.02]",
  [PROJECT_VISUAL_STYLE.TONED]:
    "h-44 w-full object-contain p-5 transition duration-300 group-hover:scale-[1.02]",
} as const;

const wrapperByStyleClass = {
  [PROJECT_VISUAL_STYLE.DEFAULT]: "h-44 w-full bg-[#0a1320]",
  [PROJECT_VISUAL_STYLE.TONED]:
    "h-44 w-full bg-[radial-gradient(circle_at_20%_15%,rgba(34,211,238,0.22),transparent_50%),linear-gradient(160deg,#0a1320_0%,#102238_100%)]",
} as const;
---

<div class="grid gap-5 md:grid-cols-2">
  {
    projects.map((project) => (
      <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#111c2b] transition hover:border-cyan-300/40 hover:shadow-[0_14px_36px_rgba(6,182,212,0.18)]">
        <div class={wrapperByStyleClass[project.visualStyle]}>
          <img
            src={project.image}
            alt={`${project.title} screenshot`}
            class={imageByStyleClass[project.visualStyle]}
            loading="lazy"
          />
        </div>
        <div class="flex flex-1 flex-col p-5">
          <h3 class="text-lg font-semibold text-slate-100">{project.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">{project.summary}</p>

          <div class="mt-4 flex flex-wrap gap-2">
            {project.stack.map((item) => (
              <span class="rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-xs text-slate-200">
                {item}
              </span>
            ))}
          </div>

          {project.links.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-3">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-sm font-medium text-slate-100 transition hover:border-cyan-300/45 hover:text-cyan-100"
                >
                  {link.kind === PROJECT_LINK_KIND.CODE ? <GitHubIcon class="size-4" /> : <LinkIcon class="size-4" />}
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </article>
    ))
  }
</div>
