---
import { SITE_CONTENT } from "../data/portfolio";

const socialLinks = SITE_CONTENT.socialLinks;
const lastUpdated = SITE_CONTENT.lastUpdated;
---

<footer id="site-footer" class="mt-16 border-t border-white/10">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-10 md:px-8 md:py-12 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Recruiter Contact</p>
      <p class="mt-2 text-sm text-slate-200 md:text-base">
        Available for Data Engineering and Agentic Engineering opportunities.
      </p>
      <p class="mt-2 text-xs text-slate-400">Last updated {lastUpdated}</p>
    </div>

    <div class="flex flex-wrap gap-2">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("mailto:") ? undefined : "_blank"}
            rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            class="inline-flex items-center rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-sm text-slate-200 transition hover:border-cyan-300/50 hover:text-cyan-100"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
